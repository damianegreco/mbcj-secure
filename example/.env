PORT=5000
DEVELOP=false

PATH_LOGS="/home/damian/proyectos/mbcj/librerias/mbcj-secure/example/logs"
PATH_BAN="/home/damian/proyectos/mbcj/librerias/mbcj-secure/example/permanent-ban.json"

# --- Ralentización (Advertencia Suave) ---
# En una ventana de 1 minuto...
SLOW_TIME_MIN=1
# ...empezar a ralentizar después de 20 peticiones.
SLOW_REQUEST=10
# ...añadiendo 100ms de retraso por cada petición extra.
SLOW_DELAY=100

# --- Bloqueo (Medida Fuerte) ---
# En una ventana de 5 minutos...
BAN_TIME_MIN=2
# ...bloquear al usuario si supera las 100 peticiones.
BAN_REQUEST=20

#limite de peso del body
BODY_LIMIT="10kb"